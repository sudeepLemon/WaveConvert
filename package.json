{
  "name": "waveconvert-studio",
  "version": "1.0.0",
  "description": "Audio Cutter and Converter",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.s1.waveconvert.desktop",
    "productName": "WaveConvert",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ]
  },
  "allowScripts": {
    "electron@29.4.6": true,
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller@5.4.0": true
  }
}
